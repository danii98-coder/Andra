<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raiz"
           fx:controller="pe.edu.unaj.andara.controller.MainController"
           styleClass="app"
           prefWidth="1280.0" prefHeight="800.0">
    <StackPane fx:id="aplicacion">
        <StackPane fx:id="contenido"/>
        <VBox fx:id="capaCabecera" StackPane.alignment="TOP_CENTER" maxHeight="-Infinity" pickOnBounds="false"/>
    </StackPane>
    <Pane fx:id="capaFlotante" pickOnBounds="false"/>
    <StackPane fx:id="capaModal"/>
    <VBox fx:id="zonaToasts" styleClass="toasts" mouseTransparent="true"
          StackPane.alignment="BOTTOM_CENTER" maxWidth="-Infinity" maxHeight="-Infinity"/>
</StackPane>
